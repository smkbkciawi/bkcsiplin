      return role.includes('GURU_PIKET') || role.includes('SUPER_ADMIN');
    }).map(g => ({ id: g.id_guru, nama: g.nama }));

    return { ok: true, data: hasil, guruPiket: guruPiket };
  } catch (e) { return { ok: false, message: e.message }; }
}

// 2. FUNGSI SINKRONISASI (Mengisi Rekap Siswa & Guru secara otomatis)
function sinkronMassalGerbang_(token, p) {
  try {
    const sesi = verifikasiToken_(token);
    const antrean = p.antrean || [];
    if (antrean.length === 0) return { ok: true, message: 'Tidak ada data.' };

    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const shGerbang = ss.getSheetByName(SHEET.GERBANG);
    const shGuru = ss.getSheetByName(SHEET.GURU_HADIR);
    const shRekapGuru = ss.getSheetByName(SHEET.REKAP_GURU); 
    const shRekapSiswa = ss.getSheetByName('REKAP_SISWA'); 
    
    const masterSiswa = readAll_(SHEET.SISWA);
    const masterGuru = readAll_(SHEET.GURU);

    let barisGerbang = [];
    let barisGuru = [];

    antrean.forEach(data => {
      let waktuAcuan = new Date();
      if (data.waktu_tap) waktuAcuan = new Date(data.waktu_tap); 
      
      const tglTap = Utilities.formatDate(waktuAcuan, TZ, 'yyyy-MM-dd');
      const jamTap = Utilities.formatDate(waktuAcuan, TZ, 'HH:mm');
      const tstamp = Utilities.formatDate(waktuAcuan, TZ, 'yyyy-MM-dd HH:mm:ss');

      const siswa = masterSiswa.find(s => String(s.nis) === String(data.nis) || String(s.uid_rfid) === String(data.nis));
      const guru = masterGuru.find(g => String(g.id_guru) === String(data.nis) || String(g.uid_rfid) === String(data.nis));
      
      if (siswa) {
        let sesiTap = data.tipe_tap || 'PAGI';
        barisGerbang.push([makeId_('GRB'), tstamp, tglTap, siswa.nis, siswa.nama, siswa.kelas, 'SISWA', sesiTap, 'HADIR', sesi.nama, data.sumber]);
        prosesRekapSiswa_(shRekapSiswa, siswa, tglTap, jamTap, sesiTap);
      } else if (guru) {
        barisGuru.push([makeId_('GRH'), tstamp, tglTap, jamTap, guru.id_guru, guru.nama, 'GURU', data.sumber]);
        prosesRekapGuru_(shRekapGuru, guru, tglTap, jamTap);
      }
    });

    if (barisGerbang.length > 0) shGerbang.getRange(shGerbang.getLastRow() + 1, 1, barisGerbang.length, barisGerbang[0].length).setValues(barisGerbang);
    if (barisGuru.length > 0) {
      const startRow = shGuru.getLastRow() + 1;
      shGuru.getRange(startRow, 1, barisGuru.length, barisGuru[0].length).setValues(barisGuru);
      shGuru.getRange(startRow, 4, barisGuru.length, 1).setNumberFormat('@'); 
    }
    return { ok: true, message: 'Sinkronisasi massal berhasil, Rekap diperbarui.' };
  } catch (e) { return { ok: false, message: 'Gagal sinkron: ' + e.message }; }
}

// 3. FUNGSI BANTU: PROSES REKAP SISWA (Otomatis buat header jika kosong)
function prosesRekapSiswa_(sh, siswa, tgl, jam, sesi) {
  const data = sh.getDataRange().getValues();
  let headers = data[0].map(h => String(h).trim().toLowerCase());
  if (headers.length < 2 || headers[0] === '') {
     headers = ['tanggal','nis','nama','kelas','jam_masuk','jam_pulang','status_masuk','status_pulang'];
     sh.getRange(1,1,1,headers.length).setValues([headers]);
  }
  const cTgl = headers.indexOf('tanggal'), cNis = headers.indexOf('nis'), cMasuk = headers.indexOf('jam_masuk'), cPulang = headers.indexOf('jam_pulang');
  
  for (let i = 1; i < data.length; i++) {
    let tglRow = data[i][cTgl] instanceof Date ? Utilities.formatDate(data[i][cTgl], TZ, 'yyyy-MM-dd') : String(data[i][cTgl]).substring(0,10);
    if (String(data[i][cNis]) === String(siswa.nis) && tglRow === tgl) {
      if (sesi === 'PULANG') sh.getRange(i+1, cPulang+1).setNumberFormat('@').setValue(jam);
      return;
    }
  }
  let newRow = new Array(headers.length).fill('');
  newRow[cTgl] = tgl; newRow[cNis] = siswa.nis; newRow[headers.indexOf('nama')] = siswa.nama; newRow[headers.indexOf('kelas')] = siswa.kelas;
  if (sesi === 'PAGI') newRow[cMasuk] = jam; else newRow[cPulang] = jam;
  sh.appendRow(newRow);
}

// 4. FUNGSI BANTU: PROSES REKAP GURU
function prosesRekapGuru_(sh, guru, tgl, jamTap) {
  const data = sh.getDataRange().getValues();
  const headers = data[0].map(h => String(h).trim().toLowerCase());
  const cId = headers.indexOf('id_guru'), cTgl = headers.indexOf('tanggal'), cMasuk = headers.indexOf('jam_masuk'), cPulang = headers.indexOf('jam_pulang'), cTotal = headers.indexOf('total_jam');
  const jamAngka = Number(jamTap.replace(':', ''));
  const isPagi = jamAngka < 1200;
  
  for (let i = 1; i < data.length; i++) {
    let tglRow = data[i][cTgl] instanceof Date ? Utilities.formatDate(data[i][cTgl], TZ, 'yyyy-MM-dd') : String(data[i][cTgl]).substring(0,10);
    if (String(data[i][cId]) === String(guru.id_guru) && tglRow === tgl) {
      if (!isPagi) {
        sh.getRange(i+1, cPulang+1).setNumberFormat('@').setValue(jamTap);
        const jm = data[i][cMasuk];
        if (jm && jm !== '-') {
          const [h1, m1] = String(jm).substring(0,5).split(':').map(Number);
          const [h2, m2] = jamTap.split(':').map(Number);
          let diff = ((h2*60)+m2) - ((h1*60)+m1); if (diff < 0) diff = 0;
          sh.getRange(i+1, cTotal+1).setNumberFormat('@').setValue(Math.floor(diff/60) + ' Jam ' + (diff%60) + ' Mnt');
        }
      }
      return;
    }
  }
  let newRow = new Array(headers.length).fill('');
  newRow[cId] = guru.id_guru; newRow[cTgl] = tgl; newRow[headers.indexOf('status')] = 'HADIR';
  if (isPagi) { newRow[cMasuk] = jamTap; newRow[cPulang] = '-'; } else { newRow[cMasuk] = '-'; newRow[cPulang] = jamTap; }
  newRow[cTotal] = '-';
  sh.appendRow(newRow);
}

// 5. FUNGSI AJAIB: SINKRONKAN DATA HARI INI (Jalankan Manual Sekali dari Apps Script)
function SinkronkanRekapHariIni() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const shGerbang = ss.getSheetByName(SHEET.GERBANG);
  const shGuru = ss.getSheetByName(SHEET.GURU_HADIR);
  const shRekapGuru = ss.getSheetByName(SHEET.REKAP_GURU);
  const shRekapSiswa = ss.getSheetByName('REKAP_SISWA');
  const hariIni = Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd');
  
  const masterSiswa = readAll_(SHEET.SISWA);
  const masterGuru = readAll_(SHEET.GURU);
  
  // Sedot Siswa
  shGerbang.getDataRange().getValues().forEach((r, i) => {
    if (i === 0 || getTanggalBersih_(r[2]) !== hariIni) return;
    const nis = String(r[3]).trim();
    const siswa = masterSiswa.find(s => String(s.nis) === nis);
    if (!siswa) return;
    let jam = String(r[1]).includes(' ') ? String(r[1]).split(' ')[1].substring(0,5) : String(r[1]).substring(0,5);
    prosesRekapSiswa_(shRekapSiswa, siswa, hariIni, jam, r[7] || 'PAGI');
  });

  // Sedot Guru
  shGuru.getDataRange().getValues().forEach((r, i) => {
    if (i === 0 || getTanggalBersih_(r[2]) !== hariIni) return;
    const id = String(r[4]).trim();
    const guru = masterGuru.find(g => String(g.id_guru) === id);
    if (!guru) return;
    let jam = String(r[3]).substring(0,5);
    prosesRekapGuru_(shRekapGuru, guru, hariIni, jam);
  });
}